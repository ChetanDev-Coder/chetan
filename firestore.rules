rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny: Reject any unauthorized reads or writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || hasRole('COORDINATOR');
    }

    // Organizations Collection
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('COORDINATOR');
    }

    // Donations Collection
    match /donations/{donationId} {
      allow read: if isAuthenticated();
      allow create: if (hasRole('DONOR') || hasRole('COORDINATOR'))
        && request.resource.data.safetyChecklistPassed == true
        && request.resource.data.estimatedKg > 0;
      allow update: if isAuthenticated(); // Must satisfy state machine transitions on server
      allow delete: if false; // Soft deletes / status cancellation only
    }

    // Match Recommendations Collection
    match /matchRecommendations/{recId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('COORDINATOR') || hasRole('DONOR');
    }

    // Assignments Collection
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('COORDINATOR') || hasRole('DONOR');
      allow update: if isAuthenticated();
      allow delete: if false; // Terminal states only
    }

    // Workflow Events Collection - Append-only
    match /workflowEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Audit Logs Collection - Strictly append-only, coordinator read
    match /auditLogs/{logId} {
      allow read: if hasRole('COORDINATOR');
      allow create: if isAuthenticated();
      allow update, delete: if false; // Tamper-proof audit logs
    }

    // Surplus Forecasts Collection
    match /surplusForecasts/{forecastId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('COORDINATOR') || hasRole('DONOR');
    }
  }
}
