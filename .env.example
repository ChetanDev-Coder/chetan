# RescueGrid AI — Environment Configuration Template
# Copy this file to .env.local to configure real Google Cloud and Firebase services.
# When variables are omitted, RescueGrid AI seamlessly runs in deterministic fallback mode.

# ==========================================
# Google Technologies
# ==========================================

# 1. Google Gemini API (Required for live Agent 1 & Agent 2 AI reasoning)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Google Maps Platform Routes API (Required for live traffic routing & transit matrices)
# Enable "Routes API" in Google Cloud Console: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# 3. Firebase Authentication & Cloud Firestore (Optional - runs local persistent adapter if unset)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 4. Firebase Admin SDK (Server-Side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 5. Google Cloud BigQuery (Optional - for high-throughput enterprise ESG analytics export)
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ID=rescuegrid_analytics_v1

# ==========================================
# Runtime Settings
# ==========================================
NODE_ENV=development
PORT=3000
